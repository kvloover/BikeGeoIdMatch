@* Download the visitor's own data as a file, or upload one made earlier. Nothing is kept server-side. *@
@inject IJSRuntime Js

<div class="data-transfer">
    <button class="secondary" @onclick="Download">Export my data</button>
    <label class="upload">Upload
        <InputFile OnChange="Upload" accept=".json,application/json" />
    </label>
    @if (message.Length > 0)
    {
        <p class="hint message">@message</p>
    }
</div>

@code {
    private const long MaxBytes = 2 * 1024 * 1024;

    [Parameter, EditorRequired] public string FileName { get; set; } = "";
    /// <summary>Produces the JSON to download.</summary>
    [Parameter, EditorRequired] public Func<string> Export { get; set; } = null!;
    /// <summary>Takes the uploaded JSON, merges it in and reports what happened.</summary>
    [Parameter, EditorRequired] public Func<string, Services.ImportSummary> Import { get; set; } = null!;

    private string message = "";

    private async Task Download()
    {
        await Js.InvokeVoidAsync("bikefit.download", FileName, Export());
        message = "";
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxBytes));
            message = Import(await reader.ReadToEndAsync()).ToString();
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException)
        {
            message = ex is IOException ? "That file is too large." : "That is not a valid export file.";
        }
    }
}
